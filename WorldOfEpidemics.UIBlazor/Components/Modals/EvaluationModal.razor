@using WorldOfEpidemics.Core

<div class="d-flex flex-column justify-content-between p-2 w-100">
    <div class="align-self-center d-flex flex-column align-items-center">
        <div class="d-flex flex-column align-items-start pt-2 pb-4">
            <h3>Score: @Evaluation.GameScore</h3>
        </div>
    </div>

    <div class="d-flex flex-row justify-content-center gap-2">
        <div class="h-100 w-50">
            <h5>Good choices</h5>
            <p>
                <small class="mb-2">
                    These choices have impacted the infection rate positively.
                </small>
            </p>
            @if (Evaluation.GoodChoiceList.Any())
            {
                <div class="list-group list-group-flush overflow-auto" style="max-height: 25rem">
                    @foreach (var goodChoice in Evaluation.GoodChoiceList)
                    {
                        <p class="list-group-item">
                            @goodChoice.EvaluationMessage
                        </p>
                    }
                </div>
            }
            else
            {
                <i>None</i>
            }
        </div>
        <div class="h-100 w-50">
            <h5>Bad choices</h5>
            <p>
                <small class="mb-2">
                    These choices have impacted the infection rate negatively.
                </small>
            </p>
            @if (Evaluation.BadChoiceList.Any())
            {
                <div class="list-group list-group-flush overflow-auto" style="max-height: 25rem">
                    @foreach (var badChoice in Evaluation.BadChoiceList)
                    {
                        <p class="list-group-item">
                            @badChoice.EvaluationMessage
                        </p>
                    }
                </div>
            }
            else
            {
                <i>None</i>
            }
        </div>
    </div>

    <div class="align-self-center d-flex flex-column align-items-center mt-5">
        <Button Color="ButtonColor.Primary" @onclick=OnCloseClick>Close</Button>
    </div>
</div>

@code {
    [Parameter]
    public Evaluation Evaluation { get; set; } = default!;

    [Parameter]
    public Modal Modal { get; set; } = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private async void OnCloseClick(MouseEventArgs e)
    {
        await Modal.HideAsync();
    }
}
