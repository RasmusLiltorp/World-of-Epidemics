@page "/"
@using WorldOfEpidemics.Core
@using WorldOfEpidemics.Core.Interactives
@using WorldOfEpidemics.UIBlazor.Components.Modals
@using static WorldOfEpidemics.UIBlazor.Events
@using WorldOfEpidemics.UIBlazor.Components.Layout
@inject UserController userController
@inject Game game
@inject IJSRuntime js
@rendermode InteractiveServer

<Modal @ref=modal UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true" ShowCloseButton="false" />

<div class="d-flex flex-column justify-content-between p-2 w-100 h-100">
    <div class="d-flex flex-row justify-content-between w-75 gap-5">
        <h2>WORLD OF EPIDEMICS</h2>
        <p style="padding-left: 4rem">Virus status:</p>
        <p style="padding-right: 16rem">Task status:</p>
    </div>
    <div class="d-flex flex-row justify-content-around w-100 h-50 align-items-center">
        <div class="d-flex flex-column justify-content-start h-100" style="width: 15%">
            <p class="align-self-center m-0">Items in the room</p>
            <div class="d-flex flex-column justify-content-start border rounded h-100">
                <ItemList @bind-Input=Input @bind-Items=itemsInRoom Command="interact" />
                <button hidden class="btn btn-primary m-1 mt-auto ms-auto">Go back</button>
            </div>
        </div>
        <div class="d-flex flex-row justify-content-center gap-2 h-100" style="width: 38%">
            <InputTextArea @bind-Value=ConsoleText @ref="gameOutput" class="h-100" style="width: 50%" readonly/>
            <InputTextArea @bind-Value=ConsoleText @ref="gameOutput" class="h-100" style="width: 50%" readonly/>
        </div>
        <div class="d-flex flex-column justify-content-start h-100" style="width: 15%">
            <p class="align-self-center m-0">Inventory</p>
            <div class="d-flex flex-column justify-content-start border rounded h-100">
                <ItemList @bind-Input=Input @bind-Items=itemsInInventory Command="use" />
            </div>
        </div>
    </div>
    <div class="d-flex flex-row justify-content-center w-100">
        <ul class="list-group list-group-horizontal gap-2 rounded-2 border">
            <li class="list-group-item border-0 list-group-item-primary">Masked</li>
            <li class="list-group-item border-0 list-group-item-danger">Disinfected</li>
            <li class="list-group-item border-0 list-group-item-success">Gloved</li>
        </ul>
    </div>
    <div class="d-flex flex-row justify-content-start w-100">
        <div class="d-flex flex-column justify-content-between ps-5 pb-3">
            <p>What is Game?</p>
            <p>your GOAL: win</p>
        </div>
    </div>
</div>

@code {
    private InputTextArea gameOutput = default!;
    private Modal modal = default!;

    private Queue<string> inputs = [];
    private Task? gameTask;
    private CancellationTokenSource? decisionTokenSource;
    private string? decision;

    private List<IInteractable> itemsInRoom = [];
    private List<IInteractable> itemsInInventory = [];
    private Container currentContainer = null;
    
    public string ConsoleText { get; set; } = string.Empty;

    private string input = string.Empty;

    public string Input {
        get => input;
        set 
        {
            if (value == string.Empty) {
                input = value;
                return;
            }
            
            input = value;
            EnqueueCommand();
        }
    }

    protected override Task OnInitializedAsync()
    {
        userController.RoomAnnounced += RoomAnnounced;
        userController.OnWriteText += WriteText;
        userController.GetDecisionStarted += GetDecisonStarted;
        userController.AfterCommandRun += OnAfterCommandRun;

        // When the UserController is ready, try to return the next command in the queue.
        userController.GetNextCommandFunc = () =>
        {
            if (inputs.TryDequeue(out string? command))
            {
                return command;
            }

            return null;
        };
        userController.GetDecisionFunc = () => decision;

        return base.OnInitializedAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            userController.WriteText(Core.Properties.Resources.MessageWelcome);
            userController.AnnounceRoom();
        }

        // Start the game on a different thread if not running already.
        if (gameTask == null || gameTask.IsCompleted)
        {
            gameTask = Task.Run(() =>
            {
                game.Run();
            });
        }
    }

    private void OnAfterCommandRun(object? sender, AfterCommandRunEventArgs e)
    {
        if (e.Command == "interact" || e.Command == "use")
        {
            // Update inventory
            itemsInInventory.Clear();
            foreach (var item in e.ContextModifier.Inventory.interactables) {
                itemsInInventory.Add(item);
            }
            
            // Update current container
            currentContainer = e.ContextModifier.CurrentContainer;
            
            InvokeAsync(StateHasChanged);
        }
    }

    private void EnqueueCommand()
    {
        inputs.Enqueue(Input);
        Input = string.Empty;

        StateHasChanged();
    }

    private void RoomAnnounced(object? sender, RoomAnnouncedEventArgs e)
    {
        WriteText(e.Room.GetWelcome());
        // Show doorways.
        /*WriteText("Doorways" + ":");
        foreach (var doorway in e.Room.Doorways)
        {
            WriteText($" - {doorway.Name}");
        }*/

        // Show items.
        /*WriteText("\r\n" + "You take a look at your surroundings." + " ");
        if (e.Room.Interactables.Count > 0)
        {
            WriteText("You see" + ":");
            foreach (var interactable in e.Room.Interactables)
            {
                WriteText($" - {interactable.Name}");
            }
        }
        else
        {
            WriteText("You don't see anything interesting.");
        }*/
        
        // Update items in room
        itemsInRoom.Clear();
        itemsInRoom = e.Room.Interactables;
        
        // Reset current container
        currentContainer = null;
        
        InvokeAsync(StateHasChanged);
    }

    private async void GetDecisonStarted(object? sender, GetDecisionStartedEventArgs e)
    {
        decision = null;
        decisionTokenSource = e.TokenSource;
        Dictionary<string, object> parameters = new();
        parameters.Add(nameof(ChoiceModal.Message), e.Message);
        parameters.Add(nameof(ChoiceModal.Choices), e.Choices);
        parameters.Add(nameof(ChoiceModal.ConfirmCallback), EventCallback.Factory.Create<string>(this, ConfirmChoice));
        await modal.ShowAsync <ChoiceModal>("Event", parameters: parameters);
    }

    private async void ConfirmChoice(string decision)
    {
        await modal.HideAsync();
        decisionTokenSource?.Cancel();
        this.decision = decision;
    }

    private void WriteText(object? sender, string text) =>
        WriteText(text);

    private void WriteText(string text)
    {
        ConsoleText += (text + "\r\n");
        if (gameOutput?.Element != null)
            js.InvokeVoidAsync("scrollToEnd", new object[] { gameOutput.Element });

        InvokeAsync(StateHasChanged);
    }
}
