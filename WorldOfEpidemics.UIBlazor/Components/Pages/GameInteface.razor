@page "/"
@using System.Text
@using WorldOfEpidemics.Core
@using WorldOfEpidemics.Core.Interactives
@using WorldOfEpidemics.UIBlazor.Components.Modals
@using static WorldOfEpidemics.UIBlazor.Events
@using WorldOfEpidemics.UIBlazor.Components.Layout
@inject UserController userController
@inject Game game
@inject IJSRuntime js
@rendermode InteractiveServer

<Modal @ref=modal UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true" ShowCloseButton="false" />
<Modal @ref=modalLarge UseStaticBackdrop="true" CloseOnEscape="false" IsVerticallyCentered="true" ShowCloseButton="false" Size="ModalSize.ExtraLarge" />

<div class="d-flex flex-column justify-content-between p-2 w-100 h-100">
    <div class="d-flex flex-column justify-content-between w-75 gap-1">
        <h2>WORLD OF EPIDEMICS</h2>
        <div class="d-flex justify-content-between align-items-center w-100 p-2">
            <div class="virus-status text-center" style="padding-left: 41rem;">
                <p class="fw-bold">Virus status</p>
                <p>Population: <span class="fw-bold">@population</span></p>
                <p>Infected: <span class="fw-bold">@infected</span></p>
                <p>Dead: <span class="fw-bold">@dead</span></p>
            </div>
            <div class="task-status text-left" style="padding-right: 9rem;">
                @{
                    int i = 0;
                }
                @foreach(var objective in currentObjectives)
                {
                    <p class="fw-bold">@(++i). @objective.Name (@(objective.IsCompleted ? "Completed" : "Not completed"))</p>
                }
            </div>
        </div>
    </div>
    <div class="d-flex flex-row justify-content-around w-100 h-50 align-items-center">
        <div class="d-flex flex-column justify-content-start h-100" style="width: 15%">
            <p class="align-self-center m-0">Items in the room</p>
            <div class="d-flex flex-column justify-content-start border rounded h-100">
                <ItemList @bind-Input=Input @bind-Items=itemsInRoom  @bind-Container=currentContainerItems />
            </div>
        </div>
        <div class="d-flex flex-row justify-content-center gap-2 h-100" style="width: 38%">
            <InputTextArea @bind-Value=ConsoleText @ref="gameOutput" class="h-100 w-50" readonly/>
            <div class="d-flex flex-column justify-content-start border rounded h-100 w-50">
                <DoorList @bind-Input=Input @bind-Doors=doorways />
            </div>
        </div>
        <div class="d-flex flex-column justify-content-start h-100" style="width: 15%">
            <p class="align-self-center m-0">Inventory</p>
            <div class="d-flex flex-column justify-content-start border rounded h-100">
                <InventoryList @bind-Input=Input @bind-Items=itemsInInventory />
            </div>
        </div>
    </div>
    <div class="d-flex flex-row justify-content-center w-100">
        <ul class="list-group list-group-horizontal gap-2 rounded-2 border">
            @if (effects.Count == 0)
            {
                <li class="list-group-item border-0 list-group-item-primary">|</li>
            }
            else
            {
                foreach (var effect in effects)
                {
                    <li class="list-group-item border-0 list-group-item-primary">@effect.Key.ToString() (@((effect.Value * 0.2).ToString("#")))</li>
                }
            }
        </ul>
    </div>
    <div class="d-flex flex-row justify-content-start w-100">
        <div class="d-flex flex-column justify-content-between ps-5 pb-3">
            <p>What is Game?</p>
            <p>your GOAL: win</p>
        </div>
    </div>
</div>

@code {
    private InputTextArea gameOutput = default!;
    private Modal modal = default!;
    private Modal modalLarge = default!;

    private Queue<string> inputs = [];
    private Task? gameTask;
    private CancellationTokenSource? decisionTokenSource;
    private string? decision;

    private List<IInteractable> itemsInRoom = [];
    private List<IInteractable> itemsInInventory = [];
    private List<Doorway> doorways = [];
    private List<IInteractable>? currentContainerItems = null;
    private IReadOnlyDictionary<Effect, int> effects = new Dictionary<Effect, int>();

    private int infected;
    private int dead;
    private int population;

    private IEnumerable<Objective> currentObjectives = [];

    private string input = string.Empty;
    private object consoleLock = new();
    private StringBuilder consoleText = new();

    public string ConsoleText {
        get
        {
            lock (consoleLock)
            {
                return consoleText.ToString();
            }
        }
        set {}
    }
    public string Input {
        get => input;
        set 
        {
            if (value == string.Empty) {
                input = value;
                return;
            }

            input = value;
            EnqueueCommand();
        }
    }

    protected override Task OnInitializedAsync()
    {
        userController.RoomAnnounced += RoomAnnounced;
        userController.OnWriteText += WriteText;
        userController.GetDecisionStarted += GetDecisonStarted;
        userController.AfterCommandRun += OnAfterCommandRun;
        userController.OnUITick += OnUITick;
        userController.OnShowEvaluation += ShowEvaluation;

        // When the UserController is ready, try to return the next command in the queue.
        userController.GetNextCommandFunc = () =>
        {
            if (inputs.TryDequeue(out string? command))
            {
                return command;
            }

            return null;
        };
        userController.GetDecisionFunc = () => decision;

        return base.OnInitializedAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            userController.WriteText(Core.Properties.Resources.MessageWelcome);
            userController.AnnounceRoom();
        }

        // Start the game on a different thread if not running already.
        if (gameTask == null || gameTask.IsCompleted)
        {
            gameTask = Task.Run(() =>
            {
                game.Run();
            });
        }
    }

    private void OnUITick(object? sender, UITickEventArgs e) {
        infected = ((Context)e.ContextModifier).CurrentVirus.NumOfInfected;
        dead = ((Context)e.ContextModifier).CurrentVirus.DeathToll;
        population = ((Context)e.ContextModifier).CurrentVirus.Population;

        currentObjectives = ActionList.ObjectiveList.Objectives;

        effects = e.ContextModifier.Effects;

        InvokeAsync(StateHasChanged);
    }

    private void OnAfterCommandRun(object? sender, AfterCommandRunEventArgs e)
    {
        if (e.Command == "interact" || e.Command == "use")
        {
            // Update inventory
            itemsInInventory.Clear();
            foreach (var item in e.ContextModifier.Inventory.interactables) {
                itemsInInventory.Add(item);
            }

            // Update current container
            currentContainerItems = e.ContextModifier.CurrentContainer?.interactables;

            InvokeAsync(StateHasChanged);
        }
    }

    private void EnqueueCommand()
    {
        inputs.Enqueue(Input);
        Input = string.Empty;

        StateHasChanged();
    }

    private void RoomAnnounced(object? sender, RoomAnnouncedEventArgs e)
    {
        WriteText(e.Room.GetWelcome());

        // Update items in room
        itemsInRoom = e.Room.Interactables;

        // Reset current container
        currentContainerItems = null;

        // Update doorways
        doorways = e.Room.Doorways.ToList();

        InvokeAsync(StateHasChanged);
    }

    private async void GetDecisonStarted(object? sender, GetDecisionStartedEventArgs e)
    {
        decision = null;
        decisionTokenSource = e.TokenSource;
        Dictionary<string, object> parameters = new();
        parameters.Add(nameof(ChoiceModal.Message), e.Message);
        parameters.Add(nameof(ChoiceModal.Choices), e.Choices);
        parameters.Add(nameof(ChoiceModal.ConfirmCallback), EventCallback.Factory.Create<string>(this, ConfirmChoice));
        await modal.ShowAsync<ChoiceModal>("Event", parameters: parameters);
    }

    private async void ConfirmChoice(string decision)
    {
        await modal.HideAsync();
        decisionTokenSource?.Cancel();
        this.decision = decision;
    }

    private void WriteText(object? sender, string text) =>
        WriteText(text);

    private void WriteText(string text)
    {
        lock (consoleLock)
        {
            consoleText.Insert(0 ,text + "\r\n");
        }

        if (gameOutput?.Element != null)
            js.InvokeVoidAsync("scrollToTop", new object[] { gameOutput.Element });

        InvokeAsync(StateHasChanged);
    }

    private async void ShowEvaluation(object? sender, ShowEvaluationEventArgs e)
    {
        Dictionary<string, object> parameters = new();
        parameters.Add(nameof(EvaluationModal.Modal), modalLarge);
        parameters.Add(nameof(EvaluationModal.Evaluation), e.Evaluation);
        await modalLarge.ShowAsync<EvaluationModal>("Time is up; Game Over!", parameters: parameters);
    }
}
